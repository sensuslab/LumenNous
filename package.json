{
  "name": "lumennous",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run && node --test scripts/editorial-review-registry.test.mjs scripts/source-ingestion-core.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "editorial:check": "vitest run src/lib/__tests__/schemas.test.ts src/lib/__tests__/editorial-workspace.test.ts && node --test scripts/editorial-review-registry.test.mjs",
    "editorial:ingest": "node scripts/editorial-review-ingest.mjs",
    "sources:check": "vitest run src/lib/__tests__/schemas.test.ts src/lib/__tests__/source-ingestion.test.ts src/lib/__tests__/source-foundation.test.ts src/lib/__tests__/editorial-workspace.test.ts && node --test scripts/source-ingestion-core.test.mjs",
    "sources:anchor": "node scripts/source-anchor.mjs",
    "sources:ingest": "node scripts/source-ingest.mjs",
    "music:import": "node scripts/import-youtube-register.mjs"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
